{
  "name": "RescisaoFuncionario",
  "type": "object",
  "description": "Rescis\u00e3o de contrato de trabalho: tipo de desligamento, verbas rescis\u00f3rias (pr\u00e9-calculadas ou informadas), anexo do termo de rescis\u00e3o e v\u00ednculo com a folha de pagamento tipo rescis\u00e3o.",
  "properties": {
    "funcionario_id": {
      "type": "string",
      "title": "ID Funcion\u00e1rio"
    },
    "funcionario_nome": {
      "type": "string",
      "title": "Funcion\u00e1rio"
    },
    "data_desligamento": {
      "type": "string",
      "format": "date",
      "title": "Data do Desligamento"
    },
    "tipo_rescisao": {
      "type": "string",
      "enum": [
        "sem_justa_causa",
        "pedido_demissao",
        "justa_causa",
        "acordo"
      ],
      "title": "Tipo de Rescis\u00e3o"
    },
    "aviso_previo": {
      "type": "string",
      "enum": [
        "indenizado",
        "trabalhado",
        "dispensado"
      ],
      "default": "indenizado",
      "title": "Aviso Pr\u00e9vio"
    },
    "saldo_salario": {
      "type": "number",
      "default": 0,
      "title": "Saldo de Sal\u00e1rio (R$)"
    },
    "aviso_previo_valor": {
      "type": "number",
      "default": 0,
      "title": "Aviso Pr\u00e9vio Indenizado (R$)"
    },
    "ferias_vencidas_valor": {
      "type": "number",
      "default": 0,
      "title": "F\u00e9rias Vencidas + 1/3 (R$)"
    },
    "ferias_proporcionais_valor": {
      "type": "number",
      "default": 0,
      "title": "F\u00e9rias Proporcionais + 1/3 (R$)"
    },
    "decimo_terceiro_valor": {
      "type": "number",
      "default": 0,
      "title": "13\u00ba Proporcional (R$)"
    },
    "multa_fgts_valor": {
      "type": "number",
      "default": 0,
      "title": "Multa FGTS (R$)"
    },
    "outros_valores": {
      "type": "number",
      "default": 0,
      "title": "Outras Verbas (R$)"
    },
    "descontos": {
      "type": "number",
      "default": 0,
      "title": "Descontos (R$)"
    },
    "total_liquido": {
      "type": "number",
      "title": "Total L\u00edquido (R$)"
    },
    "anexo_url": {
      "type": "string",
      "title": "Anexo do Termo de Rescis\u00e3o (URL)"
    },
    "anexo_nome": {
      "type": "string",
      "title": "Nome do arquivo anexado"
    },
    "status": {
      "type": "string",
      "enum": [
        "pre_calculo",
        "homologada",
        "paga"
      ],
      "default": "pre_calculo",
      "title": "Status"
    },
    "folha_pagamento_id": {
      "type": "string",
      "title": "ID da FolhaPagamento tipo rescis\u00e3o vinculada"
    },
    "lancamento_bancario_id": {
      "type": "string",
      "title": "ID do LancamentoBancario que pagou a rescis\u00e3o"
    },
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ],
      "title": "Empresa"
    },
    "observacoes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "funcionario_nome",
    "data_desligamento",
    "tipo_rescisao"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}