{
  "name": "RescisaoFuncionario",
  "type": "object",
  "description": "Controle do desligamento, pr\u00e9-c\u00e1lculo estimado de verbas rescis\u00f3rias CLT, homologa\u00e7\u00e3o, termo anexado e v\u00ednculo com a folha de rescis\u00e3o.",
  "properties": {
    "funcionario_id": {
      "type": "string",
      "title": "ID Funcion\u00e1rio"
    },
    "funcionario_nome": {
      "type": "string",
      "title": "Funcion\u00e1rio"
    },
    "data_desligamento": {
      "type": "string",
      "format": "date",
      "title": "Data do Desligamento"
    },
    "tipo_rescisao": {
      "type": "string",
      "enum": [
        "sem_justa_causa",
        "pedido_demissao",
        "justa_causa",
        "acordo"
      ],
      "title": "Tipo de Rescis\u00e3o"
    },
    "aviso_previo": {
      "type": "string",
      "enum": [
        "indenizado",
        "trabalhado",
        "dispensado"
      ],
      "default": "indenizado",
      "title": "Aviso Pr\u00e9vio"
    },
    "tempo_casa_meses": {
      "type": "number",
      "default": 0,
      "title": "Tempo de casa no desligamento (meses completos)"
    },
    "dias_aviso_previo": {
      "type": "number",
      "default": 0,
      "title": "Dias de aviso pr\u00e9vio considerados"
    },
    "ferias_pendentes_dias": {
      "type": "number",
      "default": 0,
      "title": "Dias de f\u00e9rias de per\u00edodos completos ainda pendentes"
    },
    "ferias_dobradas_dias": {
      "type": "number",
      "default": 0,
      "title": "Dias de f\u00e9rias fora do per\u00edodo concessivo, calculados em dobro"
    },
    "media_remuneracao_variavel": {
      "type": "number",
      "default": 0,
      "title": "M\u00e9dia de comiss\u00f5es e horas extras das \u00faltimas 12 folhas (R$)"
    },
    "meses_media_remuneracao": {
      "type": "number",
      "default": 0,
      "title": "Quantidade de folhas usadas na m\u00e9dia remunerat\u00f3ria"
    },
    "saldo_banco_horas": {
      "type": "number",
      "default": 0,
      "title": "Saldo do banco de horas no desligamento"
    },
    "desconto_banco_horas": {
      "type": "number",
      "default": 0,
      "title": "Desconto sugerido pelo banco de horas negativo (R$)"
    },
    "saldo_salario": {
      "type": "number",
      "default": 0,
      "title": "Saldo de Sal\u00e1rio (R$)"
    },
    "aviso_previo_valor": {
      "type": "number",
      "default": 0,
      "title": "Aviso Pr\u00e9vio Indenizado (R$)"
    },
    "ferias_vencidas_valor": {
      "type": "number",
      "default": 0,
      "title": "F\u00e9rias Pendentes + 1/3, incluindo dobra quando aplic\u00e1vel (R$)"
    },
    "ferias_proporcionais_valor": {
      "type": "number",
      "default": 0,
      "title": "F\u00e9rias Proporcionais + 1/3 (R$)"
    },
    "decimo_terceiro_valor": {
      "type": "number",
      "default": 0,
      "title": "13\u00ba Proporcional (R$)"
    },
    "multa_fgts_valor": {
      "type": "number",
      "default": 0,
      "title": "Multa FGTS (R$)"
    },
    "outros_valores": {
      "type": "number",
      "default": 0,
      "title": "Outras Verbas (R$)"
    },
    "descontos": {
      "type": "number",
      "default": 0,
      "title": "Outros Descontos (R$)"
    },
    "total_liquido": {
      "type": "number",
      "title": "Total L\u00edquido Estimado (R$)"
    },
    "anexo_url": {
      "type": "string",
      "title": "Anexo do Termo de Rescis\u00e3o (URL)"
    },
    "anexo_nome": {
      "type": "string",
      "title": "Nome do arquivo anexado"
    },
    "homologada": {
      "type": "boolean",
      "default": false,
      "title": "Rescis\u00e3o homologada"
    },
    "homologada_em": {
      "type": "string",
      "format": "date-time",
      "title": "Data e hora da homologa\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pre_calculo",
        "homologada",
        "paga"
      ],
      "default": "pre_calculo",
      "title": "Status"
    },
    "folha_pagamento_id": {
      "type": "string",
      "title": "ID da FolhaPagamento tipo rescis\u00e3o vinculada"
    },
    "lancamento_bancario_id": {
      "type": "string",
      "title": "ID do LancamentoBancario que pagou a rescis\u00e3o"
    },
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ],
      "title": "Empresa"
    },
    "observacoes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "funcionario_nome",
    "data_desligamento",
    "tipo_rescisao"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}