{
  "name": "CertificadoDigitalNFe",
  "type": "object",
  "properties": {
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ],
      "title": "Empresa"
    },
    "cnpj": {
      "type": "string",
      "title": "CNPJ (com m\u00e1scara)"
    },
    "cnpj_sem_mascara": {
      "type": "string",
      "title": "CNPJ (somente d\u00edgitos, 14)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "A1",
        "A3"
      ],
      "default": "A1",
      "title": "Tipo do certificado"
    },
    "file_uri": {
      "type": "string",
      "title": "URI do arquivo .pfx no storage privado"
    },
    "senha_secret_name": {
      "type": "string",
      "title": "Nome do secret onde a senha est\u00e1 guardada (nunca a senha em si)"
    },
    "validade": {
      "type": "string",
      "format": "date",
      "title": "Validade do certificado"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "producao",
        "homologacao"
      ],
      "default": "producao",
      "title": "Ambiente"
    },
    "is_ativo": {
      "type": "boolean",
      "default": true,
      "title": "Ativo"
    },
    "status_validacao": {
      "type": "string",
      "enum": [
        "pendente",
        "valido",
        "invalido",
        "expirado",
        "erro"
      ],
      "default": "pendente",
      "title": "Status da valida\u00e7\u00e3o"
    },
    "titular": {
      "type": "string",
      "title": "Titular (subject CN do certificado)"
    },
    "ultimo_erro": {
      "type": "string",
      "title": "\u00daltima mensagem de erro"
    },
    "ultima_validacao": {
      "type": "string",
      "format": "date-time",
      "title": "\u00daltima valida\u00e7\u00e3o"
    }
  },
  "required": [
    "empresa",
    "cnpj",
    "file_uri",
    "senha_secret_name",
    "ambiente"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}