{
  "name": "ItemCompra",
  "type": "object",
  "properties": {
    "fornecedor": {
      "type": "string",
      "title": "Fornecedor"
    },
    "fornecedor_id": {
      "type": "string",
      "title": "ID do Fornecedor mestre (opcional)"
    },
    "numero_nota": {
      "type": "string",
      "title": "N\u00famero da Nota"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "title": "Data Emiss\u00e3o"
    },
    "descricao_produto": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o do Produto"
    },
    "categoria_produto": {
      "type": "string",
      "enum": [
        "notebook",
        "tablet",
        "smartphone",
        "componente",
        "memoria",
        "armazenamento",
        "periferico",
        "software",
        "rede",
        "outro"
      ],
      "title": "Categoria"
    },
    "origem_compra": {
      "type": "string",
      "title": "Quem comprou (classifica\u00e7\u00e3o unificada: empresa, pro_labore, condominio, pessoal)"
    },
    "tipo_compra": {
      "type": "string",
      "title": "Tipo de compra (classifica\u00e7\u00e3o unificada: estoque, fretes, impostos, despesas, folha, pro_labore, obras, financeiro, outro)"
    },
    "quantidade": {
      "type": "number",
      "title": "Quantidade",
      "default": 1
    },
    "valor_unitario": {
      "type": "number",
      "title": "Valor Unit\u00e1rio"
    },
    "valor_total": {
      "type": "number",
      "title": "Valor Total"
    },
    "codigo_produto": {
      "type": "string",
      "title": "C\u00f3digo do Produto"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "cartao",
        "banco_pix",
        "banco_boleto",
        "banco_transferencia",
        "dinheiro",
        "nao_definida"
      ],
      "title": "Forma de Pagamento",
      "default": "nao_definida"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "pago",
        "parcial",
        "pendente",
        "nao_identificado"
      ],
      "title": "Status do Pagamento",
      "default": "nao_identificado"
    },
    "lancamento_bancario_id": {
      "type": "string",
      "title": "ID Lan\u00e7amento Banc\u00e1rio (quando pago via banco)"
    },
    "lancamento_cartao_id": {
      "type": "string",
      "title": "ID Lan\u00e7amento Cart\u00e3o (quando pago via cart\u00e3o)"
    },
    "valor_pago": {
      "type": "number",
      "title": "Valor efetivamente pago (R$)",
      "default": 0
    }
  },
  "required": [
    "fornecedor",
    "data_emissao",
    "descricao_produto",
    "categoria_produto",
    "valor_total"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}