{
  "name": "FolhaPagamento",
  "type": "object",
  "properties": {
    "funcionario_id": {
      "type": "string",
      "title": "ID Funcion\u00e1rio"
    },
    "funcionario_nome": {
      "type": "string",
      "title": "Nome"
    },
    "competencia": {
      "type": "string",
      "title": "Compet\u00eancia (YYYY-MM)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "mensal",
        "ferias",
        "decimo_terceiro",
        "rescisao"
      ],
      "default": "mensal",
      "title": "Tipo de folha (mensal, f\u00e9rias, 13\u00ba, rescis\u00e3o)"
    },
    "origem_compra": {
      "type": "string",
      "title": "Quem comprou (classifica\u00e7\u00e3o unificada: empresa, pro_labore, condominio, pessoal)"
    },
    "tipo_compra": {
      "type": "string",
      "title": "Tipo de compra (classifica\u00e7\u00e3o unificada: estoque, fretes, impostos, despesas, folha, pro_labore, obras, financeiro, outro)"
    },
    "salario_bruto": {
      "type": "number",
      "title": "Sal\u00e1rio Bruto"
    },
    "desconto_inss": {
      "type": "number",
      "title": "Desconto INSS",
      "default": 0
    },
    "desconto_irrf": {
      "type": "number",
      "title": "Desconto IRRF",
      "default": 0
    },
    "desconto_vt": {
      "type": "number",
      "title": "Desconto VT",
      "default": 0
    },
    "desconto_vr": {
      "type": "number",
      "title": "Desconto VR",
      "default": 0
    },
    "outros_descontos": {
      "type": "number",
      "title": "Outros Descontos",
      "default": 0
    },
    "horas_extras": {
      "type": "number",
      "title": "Horas Extras (R$)",
      "default": 0
    },
    "comissao": {
      "type": "number",
      "title": "Comiss\u00e3o",
      "default": 0
    },
    "eventos": {
      "type": "array",
      "title": "Eventos detalhados da folha (proventos e descontos avulsos al\u00e9m dos campos fixos)",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string",
            "title": "Descri\u00e7\u00e3o (ex: B\u00f4nus, Vale Alimenta\u00e7\u00e3o, Falta, Adiantamento)"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "provento",
              "desconto"
            ],
            "title": "Provento (cr\u00e9dito) ou Desconto (d\u00e9bito)"
          },
          "valor": {
            "type": "number",
            "title": "Valor (R$)"
          },
          "recorrente": {
            "type": "boolean",
            "default": false,
            "title": "Repete todo m\u00eas (herdado na gera\u00e7\u00e3o autom\u00e1tica)"
          }
        }
      }
    },
    "salario_liquido": {
      "type": "number",
      "title": "Sal\u00e1rio L\u00edquido"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "title": "Data Pagamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "adiantamento"
      ],
      "title": "Status",
      "default": "pendente"
    },
    "fgts_valor": {
      "type": "number",
      "title": "FGTS Valor",
      "default": 0
    },
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ],
      "title": "Empresa"
    },
    "gerada_automaticamente": {
      "type": "boolean",
      "default": false,
      "title": "Gerada automaticamente a partir da folha do m\u00eas anterior"
    },
    "lancamento_bancario_id": {
      "type": "string",
      "title": "ID do LancamentoBancario que confirmou o pagamento (FK direto \u2014 granularidade detalhada em VinculoExtrato)"
    }
  },
  "required": [
    "funcionario_nome",
    "competencia",
    "salario_bruto",
    "salario_liquido",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}