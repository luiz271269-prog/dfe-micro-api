{
  "name": "ApontamentoRecebivel",
  "type": "object",
  "description": "Diverg\u00eancias de auditoria, sem efeito financeiro. A chave identifica a regra e o registro de origem.",
  "properties": {
    "chave": {
      "type": "string"
    },
    "grupo": {
      "type": "string",
      "enum": [
        "total_parcelas",
        "vinculo",
        "valor_pago",
        "status",
        "vinculo_errado",
        "fora_escopo",
        "sem_parcela",
        "sem_cfop",
        "ambiguo",
        "ok"
      ]
    },
    "registro_id": {
      "type": "string"
    },
    "referencia": {
      "type": "string"
    },
    "cliente": {
      "type": "string"
    },
    "empresa": {
      "type": "string"
    },
    "motivo": {
      "type": "string"
    },
    "registrado": {
      "type": "string"
    },
    "comparado": {
      "type": "string"
    },
    "cfop": {
      "type": "string",
      "title": "CFOP da nota (quando dispon\u00edvel no XML)"
    },
    "natureza_operacao": {
      "type": "string",
      "title": "Natureza de opera\u00e7\u00e3o da nota"
    },
    "nota_fiscal_id": {
      "type": "string",
      "title": "ID da nota fiscal auditada"
    },
    "titulo_id": {
      "type": "string",
      "title": "ID do boleto com v\u00ednculo incorreto (quando aplic\u00e1vel)"
    },
    "candidatos_json": {
      "type": "string",
      "maxLength": 8000,
      "title": "Candidatos de v\u00ednculo correto serializados em JSON"
    },
    "ativo": {
      "type": "boolean"
    },
    "detectado_em": {
      "type": "string",
      "format": "date-time"
    },
    "visto_em": {
      "type": "string",
      "format": "date-time"
    },
    "inativado_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "chave",
    "grupo",
    "registro_id",
    "referencia",
    "motivo",
    "ativo",
    "detectado_em",
    "visto_em"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}