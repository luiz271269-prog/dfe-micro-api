{
  "name": "TituloCobranca",
  "type": "object",
  "properties": {
    "nosso_numero": {
      "type": "string",
      "title": "Nosso N\u00famero"
    },
    "seu_numero": {
      "type": "string",
      "title": "Seu N\u00famero"
    },
    "cliente": {
      "type": "string",
      "title": "Cliente"
    },
    "cliente_telefone": {
      "type": "string",
      "title": "Telefone / WhatsApp do cliente (com DDD)"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "title": "Data Vencimento"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "title": "Data Pagamento"
    },
    "valor_titulo": {
      "type": "number",
      "title": "Valor T\u00edtulo"
    },
    "valor_pago": {
      "type": "number",
      "title": "Valor Pago",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "em_aberto",
        "pago",
        "vencido"
      ],
      "title": "Status"
    },
    "canal_cobranca": {
      "type": "string",
      "title": "Canal Cobran\u00e7a"
    },
    "nota_fiscal_id": {
      "type": "string",
      "title": "ID Nota Fiscal"
    },
    "parcela_numero": {
      "type": "number",
      "title": "Parcela N\u00ba"
    },
    "parcela_total": {
      "type": "number",
      "title": "Total Parcelas"
    },
    "lancamento_bancario_id": {
      "type": "string",
      "title": "ID do LancamentoBancario que liquidou o t\u00edtulo (cr\u00e9dito no extrato)"
    }
  },
  "required": [
    "nosso_numero",
    "cliente",
    "data_vencimento",
    "valor_titulo",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}