{
  "name": "LancamentoBancario",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "valor": {
      "type": "number",
      "title": "Valor (R$)"
    },
    "categoria": {
      "type": "string",
      "title": "Categoria (plano de contas unificado \u2014 aceita categorias customizadas)"
    },
    "origem_compra": {
      "type": "string",
      "title": "Quem comprou (classifica\u00e7\u00e3o unificada: empresa, pro_labore, condominio, pessoal)"
    },
    "tipo_compra": {
      "type": "string",
      "title": "Tipo de compra (classifica\u00e7\u00e3o unificada: estoque, fretes, impostos, despesas, folha, pro_labore, obras, financeiro, outro)"
    },
    "saldo_apos": {
      "type": "number",
      "title": "Saldo Ap\u00f3s"
    },
    "conta_bancaria": {
      "type": "string",
      "title": "Conta Banc\u00e1ria"
    },
    "detalhe": {
      "type": "string",
      "title": "Detalhe"
    },
    "mes_referencia": {
      "type": "string",
      "title": "M\u00eas Refer\u00eancia"
    },
    "item_compra_id": {
      "type": "string",
      "title": "ID ItemCompra vinculado (legado \u2014 manter p/ retrocompat; preferir VinculoExtrato)"
    },
    "alerta_duplicidade": {
      "type": "boolean",
      "title": "Poss\u00edvel duplicidade",
      "default": false
    },
    "duplicidade_ref": {
      "type": "string",
      "title": "ID do lan\u00e7amento refer\u00eancia (quando marcado como duplicado)"
    },
    "status_conciliacao": {
      "type": "string",
      "enum": [
        "nao_conciliado",
        "parcial",
        "conciliado",
        "ignorar"
      ],
      "default": "nao_conciliado",
      "title": "Status de concilia\u00e7\u00e3o com entidade de controle"
    },
    "vinculos_count": {
      "type": "number",
      "default": 0,
      "title": "Cache: quantos VinculoExtrato apontam para este lan\u00e7amento"
    },
    "valor_conciliado": {
      "type": "number",
      "default": 0,
      "title": "Cache: soma dos valor_alocado dos v\u00ednculos (R$)"
    },
    "comprovante_drive_url": {
      "type": "string",
      "title": "Link do comprovante no Google Drive"
    },
    "comprovante_nome": {
      "type": "string",
      "title": "Nome do arquivo de comprovante"
    }
  },
  "required": [
    "data",
    "descricao",
    "valor",
    "categoria"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}