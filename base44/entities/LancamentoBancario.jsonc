{
  "name": "LancamentoBancario",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "valor": {
      "type": "number",
      "title": "Valor (R$)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "recebimento",
        "fornecedor",
        "pessoal",
        "tributo",
        "despesa_operacional",
        "financeiro",
        "saque",
        "obras_reforma",
        "transferencia",
        "interno"
      ],
      "title": "Categoria"
    },
    "saldo_apos": {
      "type": "number",
      "title": "Saldo Ap\u00f3s"
    },
    "conta_bancaria": {
      "type": "string",
      "title": "Conta Banc\u00e1ria"
    },
    "detalhe": {
      "type": "string",
      "title": "Detalhe"
    },
    "mes_referencia": {
      "type": "string",
      "title": "M\u00eas Refer\u00eancia"
    },
    "item_compra_id": {
      "type": "string",
      "title": "ID ItemCompra vinculado (evita dupla contagem)"
    },
    "alerta_duplicidade": {
      "type": "boolean",
      "title": "Poss\u00edvel duplicidade",
      "default": false
    },
    "duplicidade_ref": {
      "type": "string",
      "title": "ID do lan\u00e7amento refer\u00eancia (quando marcado como duplicado)"
    }
  },
  "required": [
    "data",
    "descricao",
    "valor",
    "categoria"
  ]
}