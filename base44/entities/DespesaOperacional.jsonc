{
  "name": "DespesaOperacional",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "fornecedor": {
      "type": "string",
      "title": "Fornecedor / Benefici\u00e1rio"
    },
    "categoria": {
      "type": "string",
      "title": "Categoria",
      "enum": [
        "aluguel",
        "energia",
        "agua",
        "internet",
        "telefone",
        "manutencao",
        "limpeza",
        "marketing",
        "contabilidade",
        "juridico",
        "seguro",
        "transporte",
        "alimentacao",
        "material_escritorio",
        "outro"
      ]
    },
    "valor": {
      "type": "number",
      "title": "Valor (R$)"
    },
    "forma_pagamento": {
      "type": "string",
      "title": "Forma de Pagamento",
      "enum": [
        "pix",
        "boleto",
        "cartao",
        "debito_automatico",
        "dinheiro",
        "transferencia"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pago",
        "pendente",
        "vencido"
      ],
      "default": "pago"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "title": "Data Vencimento"
    },
    "empresa": {
      "type": "string",
      "title": "Empresa",
      "enum": [
        "NeuralTec",
        "Liesch"
      ]
    },
    "recorrente": {
      "type": "boolean",
      "title": "Recorrente",
      "default": false
    },
    "observacoes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "data",
    "descricao",
    "categoria",
    "valor",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}