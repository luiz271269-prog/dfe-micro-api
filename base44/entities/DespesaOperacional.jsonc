{
  "name": "DespesaOperacional",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data de compet\u00eancia, preservada na baixa"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "descricao": {
      "type": "string"
    },
    "fornecedor": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "title": "Conta do plano de contas"
    },
    "origem_compra": {
      "type": "string"
    },
    "tipo_compra": {
      "type": "string"
    },
    "valor": {
      "type": "number"
    },
    "valor_pago": {
      "type": "number",
      "default": 0,
      "title": "Valor conciliado no extrato"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "pix",
        "boleto",
        "cartao",
        "debito_automatico",
        "dinheiro",
        "transferencia"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pago",
        "pendente",
        "vencido"
      ],
      "default": "pago"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ]
    },
    "recorrente": {
      "type": "boolean",
      "default": false
    },
    "regra_recorrente_id": {
      "type": "string",
      "title": "Cadastro da despesa fixa"
    },
    "competencia": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "ocorrencia_vencimento": {
      "type": "string",
      "format": "date",
      "title": "Ciclo da despesa fixa"
    },
    "observacoes": {
      "type": "string"
    },
    "lancamento_bancario_id": {
      "type": "string"
    },
    "lancamento_cartao_id": {
      "type": "string"
    },
    "comprovante_drive_url": {
      "type": "string"
    },
    "comprovante_nome": {
      "type": "string"
    },
    "foto_url": {
      "type": "string"
    },
    "assinante_nome": {
      "type": "string"
    },
    "assinatura_url": {
      "type": "string"
    },
    "conciliacao_token": {
      "type": "string"
    },
    "conciliacao_iniciada_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "data",
    "descricao",
    "categoria",
    "valor",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}