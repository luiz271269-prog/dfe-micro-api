{
  "name": "DespesaOperacional",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data (compet\u00eancia \u2014 nunca alterada pela baixa)"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "descricao": {
      "type": "string"
    },
    "fornecedor": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "title": "Categoria do plano de contas"
    },
    "origem_compra": {
      "type": "string"
    },
    "tipo_compra": {
      "type": "string"
    },
    "valor": {
      "type": "number"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "pix",
        "boleto",
        "cartao",
        "debito_automatico",
        "dinheiro",
        "transferencia"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pago",
        "pendente",
        "vencido"
      ],
      "default": "pago"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ]
    },
    "recorrente": {
      "type": "boolean",
      "default": false
    },
    "observacoes": {
      "type": "string"
    },
    "lancamento_bancario_id": {
      "type": "string"
    },
    "lancamento_cartao_id": {
      "type": "string"
    },
    "comprovante_drive_url": {
      "type": "string"
    },
    "comprovante_nome": {
      "type": "string"
    },
    "foto_url": {
      "type": "string"
    },
    "assinante_nome": {
      "type": "string"
    },
    "assinatura_url": {
      "type": "string"
    }
  },
  "required": [
    "data",
    "descricao",
    "categoria",
    "valor",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}