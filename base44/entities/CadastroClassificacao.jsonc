{
  "name": "CadastroClassificacao",
  "type": "object",
  "description": "Fonte \u00fanica do plano de contas, naturezas econ\u00f4micas, centros de custo e permiss\u00f5es de uso.",
  "properties": {
    "eixo": {
      "type": "string",
      "enum": [
        "origem",
        "tipo",
        "categoria"
      ],
      "title": "Eixo"
    },
    "chave": {
      "type": "string",
      "title": "Chave can\u00f4nica"
    },
    "rotulo": {
      "type": "string",
      "title": "Nome"
    },
    "natureza_vinculada": {
      "type": "string",
      "title": "Natureza vinculada (legado)"
    },
    "naturezas_vinculadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Naturezas econ\u00f4micas permitidas"
    },
    "centros_custo_vinculados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Centros de custo permitidos"
    },
    "nivel": {
      "type": "string",
      "enum": [
        "base",
        "subcategoria"
      ],
      "default": "base",
      "title": "N\u00edvel"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "title": "Ativo"
    },
    "perfis_permitidos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ]
      },
      "default": [
        "admin",
        "user"
      ],
      "title": "Perfis autorizados"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "title": "Ordem"
    },
    "cor": {
      "type": "string",
      "title": "Cor hexadecimal"
    }
  },
  "required": [
    "eixo",
    "chave",
    "rotulo",
    "nivel",
    "ativo",
    "perfis_permitidos"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}