{
  "name": "Funcionario",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome Completo"
    },
    "cpf": {
      "type": "string",
      "title": "CPF"
    },
    "telefone": {
      "type": "string",
      "title": "Telefone / WhatsApp (com DDD)"
    },
    "cargo": {
      "type": "string",
      "title": "Cargo"
    },
    "setor": {
      "type": "string",
      "enum": [
        "vendas",
        "assistencia",
        "financeiro",
        "compras",
        "administrativo",
        "telemarketing"
      ],
      "title": "Setor"
    },
    "data_admissao": {
      "type": "string",
      "format": "date",
      "title": "Data Admiss\u00e3o"
    },
    "data_fichamento": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "title": "Data de fichamento (auxiliar)",
      "description": "Data auxiliar do registro formal, sem substituir a admiss\u00e3o nas regras de eventos."
    },
    "jornada_referencia_diaria": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 24,
      "default": 8,
      "title": "Refer\u00eancia di\u00e1ria para compara\u00e7\u00e3o (horas)"
    },
    "jornada_referencia_semanal": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 168,
      "default": 44,
      "title": "Refer\u00eancia semanal para compara\u00e7\u00e3o (horas)"
    },
    "jornada_trabalho": {
      "type": "array",
      "maxItems": 7,
      "default": [],
      "title": "Hor\u00e1rios de trabalho por dia",
      "items": {
        "type": "object",
        "properties": {
          "dia": {
            "type": "string",
            "enum": [
              "seg",
              "ter",
              "qua",
              "qui",
              "sex",
              "sab",
              "dom"
            ]
          },
          "ativo": {
            "type": "boolean",
            "default": true
          },
          "entrada": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "saida": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "intervalo_minutos": {
            "type": "number",
            "minimum": 0,
            "maximum": 1440,
            "default": 0
          }
        },
        "required": [
          "dia",
          "entrada",
          "saida"
        ]
      }
    },
    "data_demissao": {
      "type": "string",
      "format": "date",
      "title": "Data Demiss\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "ferias",
        "afastado",
        "desligado"
      ],
      "title": "Status",
      "default": "ativo"
    },
    "salario_base": {
      "type": "number",
      "title": "Sal\u00e1rio Base"
    },
    "ferias_inicio": {
      "type": "string",
      "format": "date",
      "title": "In\u00edcio das pr\u00f3ximas f\u00e9rias"
    },
    "ferias_fim": {
      "type": "string",
      "format": "date",
      "title": "Fim das pr\u00f3ximas f\u00e9rias"
    },
    "tipo_contrato": {
      "type": "string",
      "enum": [
        "CLT",
        "PJ",
        "estagiario",
        "temporario"
      ],
      "title": "Tipo Contrato"
    },
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ],
      "title": "Empresa"
    },
    "conta_deposito": {
      "type": "string",
      "title": "Conta Dep\u00f3sito Sal\u00e1rio"
    },
    "observacoes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "nome",
    "cargo",
    "setor",
    "status",
    "tipo_contrato",
    "empresa"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}