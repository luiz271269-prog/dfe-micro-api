{
  "name": "VinculoCartao",
  "type": "object",
  "description": "V\u00ednculo audit\u00e1vel da compra no cart\u00e3o com seu documento, separado da quita\u00e7\u00e3o banc\u00e1ria. Cancelamentos preservam o v\u00ednculo original e registram a restaura\u00e7\u00e3o, sem excluir o hist\u00f3rico.",
  "properties": {
    "lancamento_cartao_id": {
      "type": "string"
    },
    "fatura_id": {
      "type": "string"
    },
    "entidade_tipo": {
      "type": "string",
      "enum": [
        "ItemCompra",
        "DespesaOperacional",
        "ObraReforma"
      ]
    },
    "entidade_id": {
      "type": "string"
    },
    "valor_alocado": {
      "type": "number",
      "minimum": 0.01
    },
    "origem": {
      "type": "string",
      "enum": [
        "automatico",
        "manual"
      ]
    },
    "motivo": {
      "type": "string",
      "maxLength": 1000
    },
    "usuario_id": {
      "type": "string"
    },
    "execucao_id": {
      "type": "string"
    },
    "fase": {
      "type": "string",
      "enum": [
        "preparado",
        "confirmado",
        "falha",
        "cancelamento_preparado",
        "cancelado"
      ],
      "default": "preparado"
    },
    "erro": {
      "type": "string",
      "maxLength": 1000
    },
    "antes_json": {
      "type": "string",
      "maxLength": 8000
    },
    "depois_json": {
      "type": "string",
      "maxLength": 8000
    },
    "cancelado_em": {
      "type": "string",
      "format": "date-time"
    },
    "cancelado_por": {
      "type": "string"
    },
    "cancelamento_motivo": {
      "type": "string",
      "maxLength": 500
    },
    "cancelamento_antes_json": {
      "type": "string",
      "maxLength": 8000
    },
    "cancelamento_depois_json": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "required": [
    "lancamento_cartao_id",
    "fatura_id",
    "entidade_tipo",
    "entidade_id",
    "valor_alocado",
    "origem",
    "motivo",
    "execucao_id",
    "fase"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}