{
  "name": "VinculoCartao",
  "type": "object",
  "description": "V\u00ednculo audit\u00e1vel de uma compra no cart\u00e3o com seu documento de origem. N\u00e3o representa pagamento banc\u00e1rio da fatura.",
  "properties": {
    "lancamento_cartao_id": {
      "type": "string"
    },
    "fatura_id": {
      "type": "string"
    },
    "entidade_tipo": {
      "type": "string",
      "enum": [
        "ItemCompra",
        "DespesaOperacional",
        "ObraReforma"
      ]
    },
    "entidade_id": {
      "type": "string"
    },
    "valor_alocado": {
      "type": "number",
      "minimum": 0.01
    },
    "origem": {
      "type": "string",
      "enum": [
        "automatico",
        "manual"
      ]
    },
    "motivo": {
      "type": "string",
      "maxLength": 1000
    },
    "usuario_id": {
      "type": "string"
    },
    "execucao_id": {
      "type": "string"
    },
    "antes_json": {
      "type": "string",
      "maxLength": 8000
    },
    "depois_json": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "required": [
    "lancamento_cartao_id",
    "fatura_id",
    "entidade_tipo",
    "entidade_id",
    "valor_alocado",
    "origem",
    "motivo",
    "execucao_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}