{
  "name": "ObraReforma",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data de execu\u00e7\u00e3o"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "title": "Data de vencimento do pagamento (planejamento \u2014 fallback: data de execu\u00e7\u00e3o)"
    },
    "descricao": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "title": "Respons\u00e1vel"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "mao_obra",
        "material"
      ],
      "title": "Tipo"
    },
    "tipo_profissional": {
      "type": "string",
      "enum": [
        "serralheiro",
        "pedreiro",
        "pintor",
        "vidros",
        "eletricista",
        "hidraulico",
        "material",
        "outros"
      ],
      "title": "Especialidade / Tipo de Servi\u00e7o"
    },
    "local_obra": {
      "type": "string",
      "enum": [
        "pavilhao",
        "loja",
        "terraco",
        "escritorio",
        "deposito",
        "infra",
        "outro"
      ],
      "title": "Local"
    },
    "origem_compra": {
      "type": "string",
      "title": "Quem comprou (classifica\u00e7\u00e3o unificada: empresa, pro_labore, condominio, pessoal)"
    },
    "tipo_compra": {
      "type": "string",
      "title": "Tipo de compra (classifica\u00e7\u00e3o unificada: estoque, fretes, impostos, despesas, folha, pro_labore, obras, financeiro, outro)"
    },
    "etapa_obra": {
      "type": "string",
      "enum": [
        "planejamento",
        "em_andamento",
        "concluida",
        "pausada"
      ],
      "title": "Etapa",
      "default": "concluida"
    },
    "numero_nota": {
      "type": "string",
      "title": "N\u00famero Nota"
    },
    "orcamento": {
      "type": "number",
      "title": "Valor Or\u00e7ado (R$)"
    },
    "valor": {
      "type": "number",
      "title": "Valor Realizado (R$)"
    },
    "forma_pagamento": {
      "type": "string",
      "title": "Forma de Pagamento"
    },
    "fornecedor_cnpj_cpf": {
      "type": "string",
      "title": "CPF / CNPJ do Prestador"
    },
    "lancamento_cartao_id": {
      "type": "string",
      "title": "ID Lan\u00e7amento Cart\u00e3o (origem)"
    },
    "lancamento_bancario_id": {
      "type": "string",
      "title": "ID do LancamentoBancario que confirmou o pagamento (PIX / transfer\u00eancia)"
    },
    "natureza": {
      "type": "string",
      "enum": [
        "investimento",
        "manutencao"
      ],
      "title": "Natureza (Gate 1 decis\u00e3o 12): investimento fica fora do resultado da opera\u00e7\u00e3o; manuten\u00e7\u00e3o \u00e9 despesa operacional"
    }
  },
  "required": [
    "data",
    "descricao",
    "tipo",
    "local_obra",
    "valor"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}