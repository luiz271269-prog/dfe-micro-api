{
  "name": "NFeAnalise",
  "type": "object",
  "properties": {
    "drive_file_id": {
      "type": "string",
      "title": "ID do arquivo no Drive"
    },
    "drive_file_name": {
      "type": "string",
      "title": "Nome do arquivo"
    },
    "chave_acesso": {
      "type": "string",
      "title": "Chave de acesso da NF-e (44 d\u00edgitos)"
    },
    "numero_nota": {
      "type": "string",
      "title": "N\u00famero da nota"
    },
    "serie": {
      "type": "string",
      "title": "S\u00e9rie"
    },
    "natureza_operacao": {
      "type": "string",
      "title": "Natureza da opera\u00e7\u00e3o"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "title": "Data de emiss\u00e3o"
    },
    "emitente_cnpj": {
      "type": "string"
    },
    "emitente_nome": {
      "type": "string"
    },
    "emitente_uf": {
      "type": "string"
    },
    "emitente_regime": {
      "type": "string",
      "enum": [
        "simples_nacional",
        "lucro_presumido_real",
        "mei",
        "desconhecido"
      ],
      "default": "desconhecido"
    },
    "destinatario_cnpj": {
      "type": "string"
    },
    "destinatario_nome": {
      "type": "string"
    },
    "destinatario_uf": {
      "type": "string"
    },
    "operacao_interestadual": {
      "type": "boolean",
      "default": false
    },
    "valor_produtos": {
      "type": "number"
    },
    "valor_frete": {
      "type": "number",
      "default": 0
    },
    "valor_desconto": {
      "type": "number",
      "default": 0
    },
    "valor_outras_despesas": {
      "type": "number",
      "default": 0
    },
    "valor_total": {
      "type": "number"
    },
    "icms_base": {
      "type": "number",
      "default": 0
    },
    "icms_total": {
      "type": "number",
      "default": 0
    },
    "icms_st_base": {
      "type": "number",
      "default": 0
    },
    "icms_st_total": {
      "type": "number",
      "default": 0
    },
    "ipi_total": {
      "type": "number",
      "default": 0
    },
    "pis_total": {
      "type": "number",
      "default": 0
    },
    "cofins_total": {
      "type": "number",
      "default": 0
    },
    "tributos_aproximados": {
      "type": "number",
      "default": 0
    },
    "produtos": {
      "type": "array",
      "title": "Produtos extra\u00eddos",
      "items": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "cfop": {
            "type": "string"
          },
          "unidade": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "valor_unitario": {
            "type": "number"
          },
          "valor_total": {
            "type": "number"
          },
          "cst_icms": {
            "type": "string"
          },
          "origem_mercadoria": {
            "type": "string"
          },
          "icms_base": {
            "type": "number",
            "default": 0
          },
          "icms_aliquota": {
            "type": "number",
            "default": 0
          },
          "icms_valor": {
            "type": "number",
            "default": 0
          },
          "icms_st_base": {
            "type": "number",
            "default": 0
          },
          "icms_st_aliquota": {
            "type": "number",
            "default": 0
          },
          "icms_st_valor": {
            "type": "number",
            "default": 0
          },
          "cst_ipi": {
            "type": "string"
          },
          "ipi_aliquota": {
            "type": "number",
            "default": 0
          },
          "ipi_valor": {
            "type": "number",
            "default": 0
          },
          "cst_pis": {
            "type": "string"
          },
          "pis_aliquota": {
            "type": "number",
            "default": 0
          },
          "pis_valor": {
            "type": "number",
            "default": 0
          },
          "cst_cofins": {
            "type": "string"
          },
          "cofins_aliquota": {
            "type": "number",
            "default": 0
          },
          "cofins_valor": {
            "type": "number",
            "default": 0
          },
          "conformidade_fiscal": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number"
              },
              "alertas": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cfop_categoria": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "status_comparacao": {
      "type": "string",
      "enum": [
        "sem_pedido",
        "match_exato",
        "divergencia_valor",
        "divergencia_qtd",
        "divergencia_produto",
        "pendente"
      ],
      "default": "pendente",
      "title": "Status da compara\u00e7\u00e3o com ItemCompra"
    },
    "item_compra_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "divergencias": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "divergencias_fiscais": {
      "type": "array",
      "title": "Diverg\u00eancias fiscais detalhadas (impostos)",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "produto": {
            "type": "string"
          },
          "campo": {
            "type": "string"
          },
          "esperado": {
            "type": "string"
          },
          "encontrado": {
            "type": "string"
          },
          "severidade": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baixa",
              "info"
            ]
          },
          "observacao": {
            "type": "string"
          }
        }
      }
    },
    "score_conformidade": {
      "type": "number",
      "title": "Score de conformidade (0-100)",
      "default": 0
    },
    "alertas_conformidade": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "drive_file_id",
    "drive_file_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}