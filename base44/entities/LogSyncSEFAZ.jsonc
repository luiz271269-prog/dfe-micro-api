{
  "name": "LogSyncSEFAZ",
  "type": "object",
  "description": "Trilha de auditoria de cada execu\u00e7\u00e3o do sync NFe (manual ou agendada).",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ]
    },
    "cnpj_sem_mascara": {
      "type": "string"
    },
    "data_execucao": {
      "type": "string",
      "format": "date-time"
    },
    "duracao_ms": {
      "type": "number"
    },
    "nsu_inicial": {
      "type": "string"
    },
    "nsu_final": {
      "type": "string"
    },
    "max_nsu_servidor": {
      "type": "string"
    },
    "documentos_baixados": {
      "type": "number",
      "default": 0
    },
    "novos": {
      "type": "number",
      "default": 0
    },
    "duplicados": {
      "type": "number",
      "default": 0
    },
    "erros": {
      "type": "number",
      "default": 0
    },
    "cstat": {
      "type": "number"
    },
    "x_motivo": {
      "type": "string"
    },
    "status_final": {
      "type": "string",
      "enum": [
        "ok",
        "sem_novos",
        "erro",
        "bloqueado_consumo",
        "poc"
      ]
    },
    "mensagem": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    }
  },
  "required": [
    "empresa",
    "data_execucao",
    "status_final"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}