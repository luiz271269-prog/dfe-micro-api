{
  "name": "ControleNSU",
  "type": "object",
  "description": "Cursor incremental isolado por empresa, ambiente e origem para o servi\u00e7o NFeDistribuicaoDFe do Ambiente Nacional.",
  "properties": {
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ]
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "producao",
        "homologacao"
      ],
      "default": "producao"
    },
    "origem_cursor": {
      "type": "string",
      "enum": [
        "real",
        "mock"
      ],
      "default": "real"
    },
    "cnpj_sem_mascara": {
      "type": "string"
    },
    "ultimo_nsu": {
      "type": "string",
      "default": "000000000000000",
      "title": "\u00daltimo NSU consumido com sucesso (15 d\u00edgitos)"
    },
    "max_nsu_servidor": {
      "type": "string",
      "default": "000000000000000",
      "title": "\u00daltimo NSU informado pelo AN como existente"
    },
    "estado_sincronizacao": {
      "type": "string",
      "enum": [
        "em_backlog",
        "sincronizado",
        "erro"
      ],
      "default": "em_backlog"
    },
    "ultima_consulta": {
      "type": "string",
      "format": "date-time"
    },
    "ultimo_status": {
      "type": "string",
      "enum": [
        "ok",
        "vazio",
        "erro",
        "rate_limit"
      ],
      "default": "vazio"
    },
    "ultimo_cstat": {
      "type": "number"
    },
    "ultimo_erro": {
      "type": "string"
    },
    "tentativas_consecutivas_erro": {
      "type": "number",
      "default": 0
    },
    "bloqueado_ate": {
      "type": "string",
      "format": "date-time",
      "title": "Pr\u00f3xima consulta fiscal permitida"
    },
    "execucao_em_andamento": {
      "type": "boolean",
      "default": false
    },
    "execucao_id": {
      "type": "string"
    },
    "execucao_iniciada_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "empresa",
    "ambiente",
    "origem_cursor",
    "cnpj_sem_mascara"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}