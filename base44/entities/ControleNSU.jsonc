{
  "name": "ControleNSU",
  "type": "object",
  "description": "Cursor incremental do servi\u00e7o NFeDistribuicaoDFe do Ambiente Nacional. Um registro por empresa.",
  "properties": {
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ]
    },
    "cnpj_sem_mascara": {
      "type": "string"
    },
    "ultimo_nsu": {
      "type": "string",
      "default": "000000000000000",
      "title": "\u00daltimo NSU consumido com sucesso (15 d\u00edgitos)"
    },
    "max_nsu_servidor": {
      "type": "string",
      "default": "000000000000000",
      "title": "\u00daltimo NSU informado pelo AN como existente"
    },
    "ultima_consulta": {
      "type": "string",
      "format": "date-time"
    },
    "ultimo_status": {
      "type": "string",
      "enum": [
        "ok",
        "vazio",
        "erro",
        "rate_limit"
      ],
      "default": "vazio"
    },
    "ultimo_cstat": {
      "type": "number"
    },
    "ultimo_erro": {
      "type": "string"
    },
    "tentativas_consecutivas_erro": {
      "type": "number",
      "default": 0
    },
    "bloqueado_ate": {
      "type": "string",
      "format": "date-time",
      "title": "Cooldown \u2014 n\u00e3o consultar antes desta data"
    }
  },
  "required": [
    "empresa",
    "cnpj_sem_mascara"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}