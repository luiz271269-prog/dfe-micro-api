{
  "name": "LancamentoCartao",
  "type": "object",
  "properties": {
    "fatura_id": {
      "type": "string",
      "title": "Fatura"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date",
      "title": "Data Lan\u00e7amento"
    },
    "estabelecimento": {
      "type": "string",
      "title": "Estabelecimento"
    },
    "categoria": {
      "type": "string",
      "title": "Categoria (legado \u2014 detalhe livre)"
    },
    "origem_compra": {
      "type": "string",
      "title": "Quem comprou (classifica\u00e7\u00e3o unificada: empresa, pro_labore, condominio, pessoal)"
    },
    "tipo_compra": {
      "type": "string",
      "title": "Tipo de compra (classifica\u00e7\u00e3o unificada: estoque, fretes, impostos, despesas, folha, pro_labore, obras, financeiro, outro)"
    },
    "valor": {
      "type": "number",
      "title": "Valor"
    },
    "natureza": {
      "type": "string",
      "enum": [
        "empresarial",
        "pessoal",
        "reembolso"
      ],
      "title": "Natureza"
    },
    "empresa_beneficiada": {
      "type": "string",
      "title": "Empresa Beneficiada"
    },
    "observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o"
    },
    "item_compra_id": {
      "type": "string",
      "title": "ID ItemCompra vinculado (evita dupla contagem)"
    },
    "pedido_central_id": {
      "type": "string",
      "title": "Pedido da Central de Compras pago nesta transa\u00e7\u00e3o (n\u00ba, ex: PC-2026-045)"
    },
    "pedido_central_internal_id": {
      "type": "string",
      "title": "ID interno do pedido na Central (refer\u00eancia auditada; o pedido continua lido online)"
    },
    "pedido_central_parcela": {
      "type": "number",
      "title": "Parcela do pedido representada nesta transa\u00e7\u00e3o"
    },
    "pedido_central_parcelas": {
      "type": "number",
      "title": "Total de parcelas do pedido no cart\u00e3o"
    },
    "pedido_central_fornecedor": {
      "type": "string",
      "title": "Fornecedor do pedido na data do v\u00ednculo"
    },
    "pedido_central_valor": {
      "type": "number",
      "title": "Valor total do pedido em R$ na data do v\u00ednculo"
    },
    "pedido_central_condicao": {
      "type": "string",
      "title": "Condi\u00e7\u00e3o de pagamento informada na Central"
    },
    "comprovante_drive_url": {
      "type": "string",
      "title": "Link do comprovante no Google Drive"
    },
    "comprovante_nome": {
      "type": "string",
      "title": "Nome do arquivo de comprovante"
    },
    "conciliacao_token": {
      "type": "string",
      "description": "Reserva tempor\u00e1ria do processamento conservador de v\u00ednculos."
    },
    "conciliacao_iniciada_em": {
      "type": "string",
      "format": "date-time"
    },
    "import_batch_id": {
      "type": "string",
      "title": "Lote de origem; concilia\u00e7\u00e3o posterior exige autoriza\u00e7\u00e3o"
    },
    "classificacao_conferida": {
      "type": "string",
      "title": "Classifica\u00e7\u00e3o conferida na revis\u00e3o do cart\u00e3o",
      "description": "Assinatura quem comprou|tipo|categoria conferida pelo usu\u00e1rio. S\u00f3 vale enquanto for igual \u00e0 classifica\u00e7\u00e3o salva; qualquer altera\u00e7\u00e3o posterior reabre a confer\u00eancia."
    }
  },
  "required": [
    "fatura_id",
    "data_lancamento",
    "estabelecimento",
    "valor",
    "natureza"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}