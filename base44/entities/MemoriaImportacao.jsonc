{
  "name": "MemoriaImportacao",
  "type": "object",
  "description": "Mem\u00f3ria de aprendizado por tipo de importa\u00e7\u00e3o. A cada importa\u00e7\u00e3o 'redonda' (sem registros faltando) conta-se um acerto. Ao atingir o limite, o usu\u00e1rio d\u00e1 o aval e o tipo passa a 'modo econ\u00f4mico' (extra\u00e7\u00e3o determin\u00edstica sem IA) enquanto o layout do arquivo continuar batendo com a assinatura aprendida. Se um arquivo divergir da assinatura, volta para IA automaticamente.",
  "properties": {
    "tipo_import": {
      "type": "string",
      "title": "Tipo de importa\u00e7\u00e3o (ex: extrato_bancario, fatura_cartao)"
    },
    "label": {
      "type": "string",
      "title": "R\u00f3tulo amig\u00e1vel do tipo"
    },
    "acertos_consecutivos": {
      "type": "number",
      "default": 0,
      "title": "Quantas importa\u00e7\u00f5es seguidas sa\u00edram redondas (sem falhas/faltando)"
    },
    "total_importacoes": {
      "type": "number",
      "default": 0,
      "title": "Total de importa\u00e7\u00f5es j\u00e1 feitas deste tipo"
    },
    "limite_para_aval": {
      "type": "number",
      "default": 5,
      "title": "Quantos acertos seguidos liberam o aval para modo econ\u00f4mico"
    },
    "status": {
      "type": "string",
      "enum": [
        "aprendendo",
        "aguardando_aval",
        "economico"
      ],
      "default": "aprendendo",
      "title": "Est\u00e1gio: aprendendo (usa IA), aguardando_aval (atingiu o limite), economico (sem IA)"
    },
    "assinatura_layout": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Assinatura do layout aprendido \u2014 campos/colunas que sempre aparecem. Arquivo que n\u00e3o bater volta para IA."
    },
    "ultima_importacao": {
      "type": "string",
      "format": "date-time",
      "title": "Data da \u00faltima importa\u00e7\u00e3o contabilizada"
    },
    "data_aval": {
      "type": "string",
      "format": "date-time",
      "title": "Quando o usu\u00e1rio deu o aval para modo econ\u00f4mico"
    },
    "avalizado_por": {
      "type": "string",
      "title": "Email de quem deu o aval"
    },
    "observacoes": {
      "type": "string",
      "title": "Notas / hist\u00f3rico de diverg\u00eancias"
    }
  },
  "required": [
    "tipo_import"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}