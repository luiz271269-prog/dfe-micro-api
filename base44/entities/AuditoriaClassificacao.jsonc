{
  "name": "AuditoriaClassificacao",
  "type": "object",
  "description": "Trilha imut\u00e1vel das classifica\u00e7\u00f5es financeiras autom\u00e1ticas e manuais.",
  "properties": {
    "execucao_id": {
      "type": "string",
      "title": "ID da execu\u00e7\u00e3o"
    },
    "entidade_tipo": {
      "type": "string",
      "title": "Entidade alterada"
    },
    "entidade_id": {
      "type": "string",
      "title": "ID do registro"
    },
    "origem_alteracao": {
      "type": "string",
      "enum": [
        "automatica",
        "manual"
      ],
      "title": "Origem da altera\u00e7\u00e3o"
    },
    "confianca": {
      "type": "number",
      "title": "Confian\u00e7a da classifica\u00e7\u00e3o (0-100)"
    },
    "motivos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Evid\u00eancias utilizadas"
    },
    "antes_json": {
      "type": "string",
      "title": "Classifica\u00e7\u00e3o anterior"
    },
    "depois_json": {
      "type": "string",
      "title": "Classifica\u00e7\u00e3o aplicada"
    }
  },
  "required": [
    "execucao_id",
    "entidade_tipo",
    "entidade_id",
    "origem_alteracao",
    "antes_json",
    "depois_json"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}