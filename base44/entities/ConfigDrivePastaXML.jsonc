{
  "name": "ConfigDrivePastaXML",
  "type": "object",
  "description": "Configura\u00e7\u00e3o de pasta monitorada no Google Drive para varredura autom\u00e1tica di\u00e1ria. O campo tipo_pasta define o que ser\u00e1 feito com os arquivos: 'xml' importa/analisa NF-e, 'comprovante' cria inbox deduplicado, e os demais tipos (extrato, fatura_cartao, etc.) coletam os arquivos novos em ArquivoImportInbox j\u00e1 marcados com o tipo de importa\u00e7\u00e3o.",
  "properties": {
    "tipo_pasta": {
      "type": "string",
      "enum": [
        "xml",
        "comprovante",
        "extrato_bancario",
        "boletos_liquidados",
        "relatorio_nfs",
        "relatorio_vendas_detalhado",
        "compras_fornecedor",
        "fatura_cartao",
        "obra_reforma",
        "folha_pagamento",
        "dda_boletos",
        "despesas_operacionais"
      ],
      "default": "xml",
      "title": "Tipo de importa\u00e7\u00e3o dos arquivos desta pasta"
    },
    "folder_id": {
      "type": "string",
      "title": "ID da pasta no Google Drive"
    },
    "folder_name": {
      "type": "string",
      "title": "Nome amig\u00e1vel da pasta (ex: Ellitte/XMLs/Retorno)"
    },
    "caminho_rede": {
      "type": "string",
      "title": "Caminho de rede local (ex: E:\\Ellitte\\XMLs\\Retorno ou \\\\servidor\\xmls)"
    },
    "tipo_caminho": {
      "type": "string",
      "enum": [
        "disco_local",
        "unc_rede",
        "drive_sincronizado",
        "outro"
      ],
      "default": "drive_sincronizado",
      "title": "Tipo do caminho"
    },
    "host_servidor": {
      "type": "string",
      "title": "Servidor/Host (quando UNC)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "title": "Varredura autom\u00e1tica ativa"
    },
    "ultima_varredura": {
      "type": "string",
      "format": "date-time",
      "title": "\u00daltima varredura executada"
    },
    "ultima_quantidade": {
      "type": "number",
      "default": 0,
      "title": "Quantidade de arquivos da \u00faltima varredura"
    },
    "ultimo_processados": {
      "type": "number",
      "default": 0,
      "title": "Quantos foram efetivamente processados na \u00faltima rodada"
    },
    "ultimo_status": {
      "type": "string",
      "title": "Resumo do \u00faltimo resultado (ok/erro + mensagem)"
    },
    "observacoes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "folder_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}