{
  "name": "SugestaoConciliacao",
  "type": "object",
  "description": "Sugest\u00f5es de concilia\u00e7\u00e3o. RegraRecorrente representa revis\u00e3o de despesas fixas; cart\u00e3o confirma a compra, n\u00e3o o pagamento da fatura.",
  "properties": {
    "lancamento_bancario_id": {
      "type": "string"
    },
    "lancamento_cartao_id": {
      "type": "string"
    },
    "canal": {
      "type": "string",
      "enum": [
        "extrato",
        "cartao"
      ]
    },
    "competencia": {
      "type": "string"
    },
    "bloqueada": {
      "type": "boolean",
      "default": false
    },
    "confirmada_por": {
      "type": "string"
    },
    "entidade_tipo": {
      "type": "string",
      "enum": [
        "DespesaOperacional",
        "Tributo",
        "FolhaPagamento",
        "FaturaCartao",
        "RegraRecorrente"
      ]
    },
    "entidade_id": {
      "type": "string"
    },
    "descricao_conta": {
      "type": "string"
    },
    "fornecedor": {
      "type": "string"
    },
    "valor_esperado": {
      "type": "number"
    },
    "valor_extrato": {
      "type": "number"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "data_extrato": {
      "type": "string",
      "format": "date"
    },
    "descricao_extrato": {
      "type": "string"
    },
    "diff_dias": {
      "type": "number"
    },
    "confianca": {
      "type": "number",
      "default": 70
    },
    "motivo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "confirmada",
        "rejeitada"
      ],
      "default": "pendente"
    },
    "resolvida_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "entidade_tipo",
    "entidade_id",
    "valor_esperado",
    "valor_extrato"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.entidade_tipo": "RegraRecorrente"
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.entidade_tipo": {
                "$ne": "RegraRecorrente"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.entidade_tipo": {
                "$ne": "RegraRecorrente"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.entidade_tipo": {
                "$ne": "RegraRecorrente"
              }
            }
          ]
        }
      ]
    }
  }
}