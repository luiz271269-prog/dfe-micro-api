{
  "name": "RegraRecorrente",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome da Regra"
    },
    "padrao_descricao": {
      "type": "string",
      "title": "Palavra-chave da descri\u00e7\u00e3o no extrato"
    },
    "fornecedor": {
      "type": "string",
      "title": "Fornecedor/Benefici\u00e1rio"
    },
    "valor_esperado": {
      "type": "number",
      "title": "Valor esperado (R$)"
    },
    "tolerancia_percentual": {
      "type": "number",
      "title": "Toler\u00e2ncia (%)",
      "default": 5
    },
    "dia_vencimento": {
      "type": "number",
      "title": "Dia do m\u00eas esperado"
    },
    "frequencia": {
      "type": "string",
      "enum": [
        "mensal",
        "trimestral",
        "anual"
      ],
      "default": "mensal",
      "title": "Frequ\u00eancia"
    },
    "mes_inicio": {
      "type": "string",
      "title": "M\u00eas inicial da recorr\u00eancia (YYYY-MM)"
    },
    "conta_bancaria": {
      "type": "string",
      "title": "Conta do extrato (vazio = todas)"
    },
    "categoria": {
      "type": "string",
      "title": "Categoria (plano de contas unificado \u2014 aceita categorias customizadas)"
    },
    "origem_compra": {
      "type": "string",
      "title": "Quem comprou (classifica\u00e7\u00e3o unificada: empresa, pro_labore, condominio, pessoal)"
    },
    "tipo_compra": {
      "type": "string",
      "title": "Tipo de compra (classifica\u00e7\u00e3o unificada: estoque, fretes, impostos, despesas, folha, pro_labore, obras, financeiro, outro)"
    },
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ],
      "title": "Empresa"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "pix",
        "boleto",
        "debito_automatico",
        "cartao",
        "transferencia"
      ],
      "title": "Forma de pagamento t\u00edpica"
    },
    "is_ativa": {
      "type": "boolean",
      "title": "Ativa",
      "default": true
    },
    "historico_valores": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "title": "Hist\u00f3rico de valores observados"
    },
    "ultima_ocorrencia": {
      "type": "string",
      "format": "date",
      "title": "\u00daltima ocorr\u00eancia detectada"
    },
    "observacoes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "nome",
    "padrao_descricao",
    "valor_esperado",
    "categoria"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}