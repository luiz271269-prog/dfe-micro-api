{
  "name": "RegraRecorrente",
  "type": "object",
  "description": "Cadastro pr\u00e9vio de despesas fixas. A previs\u00e3o existe antes da compra ou pagamento; categoria \u00e9 a chave da conta no plano de contas.",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome da despesa fixa"
    },
    "padrao_descricao": {
      "type": "string",
      "title": "Palavra-chave no extrato ou cart\u00e3o"
    },
    "fornecedor": {
      "type": "string"
    },
    "valor_esperado": {
      "type": "number"
    },
    "tolerancia_percentual": {
      "type": "number",
      "default": 5
    },
    "dia_vencimento": {
      "type": "number"
    },
    "frequencia": {
      "type": "string",
      "enum": [
        "semanal",
        "mensal",
        "trimestral",
        "anual"
      ],
      "default": "mensal"
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "mes_inicio": {
      "type": "string"
    },
    "conta_bancaria": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "title": "Chave da conta no plano de contas"
    },
    "origem_compra": {
      "type": "string"
    },
    "tipo_compra": {
      "type": "string"
    },
    "empresa": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ]
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "pix",
        "boleto",
        "debito_automatico",
        "cartao",
        "transferencia"
      ]
    },
    "is_ativa": {
      "type": "boolean",
      "default": true
    },
    "historico_valores": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "ultima_ocorrencia": {
      "type": "string",
      "format": "date"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "padrao_descricao",
    "valor_esperado",
    "categoria"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}