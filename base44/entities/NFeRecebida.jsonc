{
  "name": "NFeRecebida",
  "type": "object",
  "description": "Documento fiscal eletr\u00f4nico recebido do Ambiente Nacional via NFeDistribuicaoDFe. Chave de acesso \u00fanica por origem.",
  "properties": {
    "chave_acesso": {
      "type": "string",
      "title": "Chave de acesso (44 d\u00edgitos)"
    },
    "nsu": {
      "type": "string",
      "title": "NSU atribu\u00eddo pelo AN"
    },
    "origem_documento": {
      "type": "string",
      "enum": [
        "real",
        "mock"
      ],
      "default": "real",
      "title": "Origem fiscal do documento"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "nfe",
        "nfe_resumo",
        "cte",
        "nfce",
        "evento",
        "outro"
      ],
      "default": "outro"
    },
    "empresa_destinataria": {
      "type": "string",
      "enum": [
        "NeuralTec",
        "Liesch"
      ]
    },
    "cnpj_destinatario": {
      "type": "string"
    },
    "cnpj_emitente": {
      "type": "string"
    },
    "nome_emitente": {
      "type": "string"
    },
    "uf_emitente": {
      "type": "string"
    },
    "numero_nota": {
      "type": "string"
    },
    "serie": {
      "type": "string"
    },
    "data_emissao": {
      "type": "string",
      "format": "date-time"
    },
    "valor_total": {
      "type": "number"
    },
    "valor_produtos": {
      "type": "number"
    },
    "valor_icms": {
      "type": "number"
    },
    "valor_icms_st": {
      "type": "number"
    },
    "valor_ipi": {
      "type": "number"
    },
    "natureza_operacao": {
      "type": "string"
    },
    "xml_file_uri": {
      "type": "string",
      "title": "URI privado do XML no storage"
    },
    "schema_documento": {
      "type": "string"
    },
    "status_manifestacao": {
      "type": "string",
      "enum": [
        "pendente",
        "ciencia",
        "confirmada",
        "desconhecida",
        "nao_realizada"
      ],
      "default": "pendente"
    },
    "status_processamento": {
      "type": "string",
      "enum": [
        "novo",
        "analisado",
        "vinculado",
        "ignorado",
        "erro"
      ],
      "default": "novo"
    },
    "item_compra_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nfe_analise_id": {
      "type": "string"
    },
    "divergencias": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "erro_processamento": {
      "type": "string"
    }
  },
  "required": [
    "chave_acesso",
    "nsu",
    "origem_documento",
    "empresa_destinataria"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}