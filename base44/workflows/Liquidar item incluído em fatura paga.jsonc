{
  "name": "Liquidar item inclu\u00eddo em fatura paga",
  "description": "Ao receber um lan\u00e7amento com fatura, analisa e vincula somente sua composi\u00e7\u00e3o documental. N\u00e3o altera pagamentos, mesmo em faturas j\u00e1 quitadas.",
  "trigger": {
    "condition": "${ (.trigger.data.fatura_id // \"\") != \"\" and (.trigger.event_type == \"create\" or ((.trigger.changed_fields // []) | index(\"fatura_id\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "LancamentoCartao"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "liquidar_item_incluido_em_fatura_paga",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "conciliar_compra_cartao": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "conciliarCartoesDespesas",
            "args": {
              "acao": "aplicar",
              "somente_compras": true,
              "fatura_id": "${ .trigger.data.fatura_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Identificar composi\u00e7\u00e3o da fatura",
            "description": "V\u00ednculo documental sem baixa ou rateio"
          }
        }
      }
    ]
  }
}