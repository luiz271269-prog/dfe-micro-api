{
  "name": "Liquidar item inclu\u00eddo em fatura paga",
  "description": "Reprocessa a fatura quando um lan\u00e7amento de cart\u00e3o \u00e9 criado ou muda de fatura, cobrindo itens inclu\u00eddos depois do pagamento.",
  "trigger": {
    "condition": "${ .trigger.event_type == \"create\" or (.trigger.changed_fields | index(\"fatura_id\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "LancamentoCartao"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "liquidar_item_incluido_em_fatura_paga",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "verificar_fatura": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "liquidarItensFaturaPaga",
            "args": {
              "fatura_id": "${ .trigger.data.fatura_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Verificar fatura do item",
            "description": "Liquida se j\u00e1 estiver paga"
          }
        }
      }
    ]
  }
}