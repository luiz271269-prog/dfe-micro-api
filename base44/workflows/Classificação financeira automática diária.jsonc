{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "classificacao_financeira_automatica_diaria",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "classificar_historico": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "revisarTiposGasto",
            "args": {
              "action": "aplicar_automatico",
              "dry_run": false
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Classificar financeiro",
            "description": "Aplica matriz e sincroniza v\u00ednculos"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Classifica\u00e7\u00e3o financeira autom\u00e1tica di\u00e1ria",
  "description": "Aplica diariamente a matriz \u00fanica de respons\u00e1vel econ\u00f4mico, natureza econ\u00f4mica e conta anal\u00edtica, aprendendo com o hist\u00f3rico e sincronizando v\u00ednculos."
}