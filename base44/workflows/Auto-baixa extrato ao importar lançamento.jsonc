{
  "name": "Auto-baixa extrato ao importar lan\u00e7amento",
  "description": "Ao receber um lan\u00e7amento banc\u00e1rio, concilia contas, compras por PIX ou boleto e pagamentos de faturas de cart\u00e3o.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "LancamentoBancario"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_baixa_extrato_ao_importar_lancamento",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "conciliar_contas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "conciliarLoteExtrato",
            "args": {}
          },
          "then": "conciliar_compras",
          "x-base44": {
            "title": "Conciliar contas",
            "description": "Verifica obriga\u00e7\u00f5es do extrato"
          }
        }
      },
      {
        "conciliar_compras": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "conciliarComprasPagamentos",
            "args": {}
          },
          "then": "conciliar_faturas",
          "x-base44": {
            "title": "Conciliar compras",
            "description": "Vincula PIX e boletos"
          }
        }
      },
      {
        "conciliar_faturas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "conciliarFaturasCartao",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Conciliar faturas",
            "description": "Vincula pagamento dos cart\u00f5es"
          }
        }
      }
    ]
  }
}