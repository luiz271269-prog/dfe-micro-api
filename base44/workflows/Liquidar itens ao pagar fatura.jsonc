{
  "name": "Liquidar itens ao pagar fatura",
  "description": "Quando uma fatura de cart\u00e3o vira paga_total, liquida em cascata as despesas, compras e obras vinculadas aos itens dessa fatura.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"paga_total\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "FaturaCartao"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "liquidar_itens_ao_pagar_fatura",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "liquidarItensFaturaPaga",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}